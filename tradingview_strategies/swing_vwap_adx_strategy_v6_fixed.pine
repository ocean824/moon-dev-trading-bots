//@version=6
// Swing Anchored VWAP + ADX Strategy
// Combines Swing Anchored VWAP levels with ADX trend strength filtering
// Author: Moon Dev Trading Strategy

strategy("Swing VWAP + ADX Strategy [MD]", shorttitle="SwingVWAP+ADX [MD]", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=10, commission_type=strategy.commission.percent, commission_value=0.1, pyramiding=0, max_bars_back=5000)

// ====== SWING VWAP INPUTS ======
swing_length = input.int(50, title="Swing Detection Length", group="Swing VWAP Settings")
vwap_offset = input.float(0.5, title="VWAP Entry Offset %", group="Swing VWAP Settings", minval=0.0, maxval=5.0, step=0.1)
use_vwap_bands = input.bool(false, title="Use VWAP Bands", group="Swing VWAP Settings")
band_mult = input.float(1.5, title="Band Multiplier %", group="Swing VWAP Settings", minval=0.5, maxval=5.0)

// ====== ADX INPUTS ======
adxLength = input.int(14, title="ADX Length", group="ADX Settings")
adxThreshold = input.int(25, title="ADX Threshold (Trend Strength)", group="ADX Settings", minval=15, maxval=50)
diThreshold = input.int(20, title="DI Threshold (Direction Strength)", group="ADX Settings", minval=10, maxval=40)
useADXFilter = input.bool(true, title="Use ADX Filter", group="ADX Settings")

// ====== STRATEGY INPUTS ======
tradeDirection = input.string("Both", title="Trade Direction", options=["Long", "Short", "Both"], group="Strategy Settings")
useTimeFilter = input.bool(false, title="Use Time Filter", group="Strategy Settings")
startHour = input.int(9, title="Start Hour (24h)", group="Strategy Settings", minval=0, maxval=23)
endHour = input.int(16, title="End Hour (24h)", group="Strategy Settings", minval=0, maxval=23)

// ====== RISK MANAGEMENT ======
useSL = input.bool(true, title="Use Stop Loss", group="Risk Management")
useTP = input.bool(true, title="Use Take Profit", group="Risk Management")
slPercent = input.float(2.0, title="Stop Loss %", group="Risk Management", minval=0.5, maxval=10.0)
tpPercent = input.float(4.0, title="Take Profit %", group="Risk Management", minval=1.0, maxval=20.0)
useTrailing = input.bool(false, title="Use Trailing Stop", group="Risk Management")
trailPercent = input.float(1.5, title="Trailing Stop %", group="Risk Management", minval=0.5, maxval=5.0)

// ====== SWING DETECTION ======
highestHigh = ta.highest(high, swing_length)
lowestLow = ta.lowest(low, swing_length)

// Detect swing points
isSwingHigh = high[swing_length] == highestHigh[swing_length] and high[swing_length] > high[swing_length-1] and high[swing_length] > high[swing_length+1]
isSwingLow = low[swing_length] == lowestLow[swing_length] and low[swing_length] < low[swing_length-1] and low[swing_length] < low[swing_length+1]

// Track swing points
var float lastSwingHigh = na
var int lastSwingHighBar = na
var float lastSwingLow = na
var int lastSwingLowBar = na

if isSwingHigh
    lastSwingHigh := high[swing_length]
    lastSwingHighBar := bar_index - swing_length

if isSwingLow
    lastSwingLow := low[swing_length]
    lastSwingLowBar := bar_index - swing_length

// Calculate simple VWAP from swing points
// Using typical price and volume from swing point to current
calcVwapFromSwing(swingBar, swingPrice) =>
    if na(swingBar)
        na
    else
        barsBack = bar_index - swingBar
        if barsBack > 0 and barsBack < 500  // Limit lookback
            sumPV = 0.0
            sumV = 0.0
            for i = 0 to barsBack
                sumPV := sumPV + (high[i] + low[i] + close[i]) / 3 * volume[i]
                sumV := sumV + volume[i]
            sumV > 0 ? sumPV / sumV : na
        else
            na

highVwap = calcVwapFromSwing(lastSwingHighBar, lastSwingHigh)
lowVwap = calcVwapFromSwing(lastSwingLowBar, lastSwingLow)

// ====== ADX CALCULATIONS ======
dirmov(len) =>
    up = ta.change(high)
    down = -ta.change(low)
    plusDM = na(up) ? na : (up > down and up > 0 ? up : 0)
    minusDM = na(down) ? na : (down > up and down > 0 ? down : 0)
    truerange = ta.rma(ta.tr, len)
    plus = fixnan(100 * ta.rma(plusDM, len) / truerange)
    minus = fixnan(100 * ta.rma(minusDM, len) / truerange)
    [plus, minus]

adx(dilen, adxlen) =>
    [plus, minus] = dirmov(dilen)
    sum = plus + minus
    adx_val = 100 * ta.rma(math.abs(plus - minus) / (sum == 0 ? 1 : sum), adxlen)
    [adx_val, plus, minus]

[adxValue, diPlus, diMinus] = adx(adxLength, adxLength)

// ADX Conditions
adxStrong = adxValue > adxThreshold
upTrend = diPlus > diMinus and diPlus > diThreshold
downTrend = diMinus > diPlus and diMinus > diThreshold

// ====== ENTRY CONDITIONS ======
// Time Filter
timeFilter = not useTimeFilter or (hour >= startHour and hour <= endHour)

// VWAP Entry Conditions (simplified)
longVwapCondition = not na(lowVwap) and close > lowVwap and close <= lowVwap * (1 + vwap_offset/100) and close > open
shortVwapCondition = not na(highVwap) and close < highVwap and close >= highVwap * (1 - vwap_offset/100) and close < open

// Combined Entry Conditions
longCondition = longVwapCondition and (not useADXFilter or (adxStrong and upTrend)) and timeFilter and (tradeDirection == "Long" or tradeDirection == "Both")
shortCondition = shortVwapCondition and (not useADXFilter or (adxStrong and downTrend)) and timeFilter and (tradeDirection == "Short" or tradeDirection == "Both")

// ====== EXIT CONDITIONS ======
// Exit on opposite VWAP touch or ADX weakness
longExitCondition = strategy.position_size > 0 and (close < lowVwap * 0.99 or (useADXFilter and adxValue < adxThreshold * 0.8))
shortExitCondition = strategy.position_size < 0 and (close > highVwap * 1.01 or (useADXFilter and adxValue < adxThreshold * 0.8))

// ====== STRATEGY EXECUTION ======
// Entry Orders
if longCondition
    strategy.entry("Long", strategy.long)
    
if shortCondition
    strategy.entry("Short", strategy.short)

// Exit Orders
if longExitCondition
    strategy.close("Long")
    
if shortExitCondition
    strategy.close("Short")

// Stop Loss and Take Profit
if strategy.position_size > 0
    stopLoss = strategy.position_avg_price * (1 - slPercent / 100)
    takeProfit = strategy.position_avg_price * (1 + tpPercent / 100)
    if useSL
        strategy.exit("Long Exit", "Long", stop=stopLoss, limit=useTP ? takeProfit : na, trail_offset=useTrailing ? trailPercent * 100 : na)
                      
if strategy.position_size < 0
    stopLoss = strategy.position_avg_price * (1 + slPercent / 100)
    takeProfit = strategy.position_avg_price * (1 - tpPercent / 100)
    if useSL
        strategy.exit("Short Exit", "Short", stop=stopLoss, limit=useTP ? takeProfit : na, trail_offset=useTrailing ? trailPercent * 100 : na)

// ====== PLOTTING ======
// Plot VWAP lines
plot(highVwap, title="High VWAP", color=color.blue, linewidth=2, style=plot.style_line)
plot(lowVwap, title="Low VWAP", color=color.lime, linewidth=2, style=plot.style_line)

// Plot VWAP bands if enabled
highVwapUpper = use_vwap_bands ? highVwap * (1 + band_mult/100) : na
highVwapLower = use_vwap_bands ? highVwap * (1 - band_mult/100) : na
lowVwapUpper = use_vwap_bands ? lowVwap * (1 + band_mult/100) : na
lowVwapLower = use_vwap_bands ? lowVwap * (1 - band_mult/100) : na

plot(highVwapUpper, title="High VWAP Upper", color=color.new(color.blue, 70), linewidth=1)
plot(highVwapLower, title="High VWAP Lower", color=color.new(color.blue, 70), linewidth=1)
plot(lowVwapUpper, title="Low VWAP Upper", color=color.new(color.lime, 70), linewidth=1)
plot(lowVwapLower, title="Low VWAP Lower", color=color.new(color.lime, 70), linewidth=1)

// Plot swing points
plotshape(isSwingHigh, title="Swing High", location=location.abovebar, color=color.blue, style=shape.triangledown, size=size.small, offset=-swing_length)
plotshape(isSwingLow, title="Swing Low", location=location.belowbar, color=color.lime, style=shape.triangleup, size=size.small, offset=-swing_length)

// Plot entry signals
plotshape(longCondition, title="Long Entry", location=location.belowbar, color=color.green, style=shape.labelup, text="BUY", size=size.small)
plotshape(shortCondition, title="Short Entry", location=location.abovebar, color=color.red, style=shape.labeldown, text="SELL", size=size.small)

// Background color for ADX strength
bgcolor(adxStrong ? color.new(color.blue, 95) : na, title="Strong Trend Background")

// ====== INFO PANEL ======
var label infoLabel = na
label.delete(infoLabel)

if barstate.islast
    labelText = "Swing VWAP+ADX\n" + "ADX: " + str.tostring(adxValue, "#.#") + "\n" + "DI+: " + str.tostring(diPlus, "#.#") + "\n" + "DI-: " + str.tostring(diMinus, "#.#")
    infoLabel := label.new(bar_index + 5, high, labelText, color=color.new(color.gray, 80), textcolor=color.white, style=label.style_label_left, size=size.small)

// ====== ALERTS ======
alertcondition(longCondition, title="Long Entry Alert", message="Swing VWAP+ADX Long Signal")
alertcondition(shortCondition, title="Short Entry Alert", message="Swing VWAP+ADX Short Signal")
alertcondition(longExitCondition or shortExitCondition, title="Exit Alert", message="Swing VWAP+ADX Exit Signal")